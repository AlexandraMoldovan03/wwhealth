{
  "expo": {
    "name": "WWHealth",
    "slug": "wwhealth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to analyze images.",
          "cameraPermission": "The app needs camera access to take photos for analysis."
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "The app needs camera access so doctors can scan an emergency passport QR code.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow WWHealth to record your symptom description."
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "WWHealth uses Face ID to unlock the app and to confirm sensitive actions. No face data leaves your device."
        }
      ]
    ],
    "scheme": "wwhealth",
    "experiments": {
      "typedRoutes": true
    }
  }
}
