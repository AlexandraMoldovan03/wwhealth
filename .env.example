# Copy this file to `.env` and adjust. Only EXPO_PUBLIC_* variables reach the app.
# NEVER put secrets (API keys, service-role keys) here — everything is bundled into the app.

# Base URL of your FastAPI backend. On a physical phone use your computer's LAN IP, not localhost.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000

# true = use mock data / simulated AI results, false = call the real backend.
EXPO_PUBLIC_USE_MOCK_API=true
