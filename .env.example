# Copy to `.env` and adjust. Only EXPO_PUBLIC_* variables reach the app.
# NEVER put secrets here (Gemini / ElevenLabs / Supabase secret key live in backend/.env).

# true  = MOCK mode: fake data, works without backend (default)
# false = API mode: calls the FastAPI backend below
EXPO_PUBLIC_USE_MOCKS=true

# FastAPI URL. "auto" = the Mac running Metro (follows Wi-Fi/hotspot IP changes), port 8000.
# Set a full URL (http://<ip>:8000) only to point at another machine.
EXPO_PUBLIC_API_BASE_URL=auto

# Supabase Auth (empty = demo login). Publishable key only — NEVER the secret key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
