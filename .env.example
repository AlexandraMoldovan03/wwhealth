# Copy to `.env` and adjust. Only EXPO_PUBLIC_* variables reach the app.
# NEVER put secrets here (Gemini / ElevenLabs / Auth0 secrets live in backend/.env).

# true  = MOCK mode: fake data, works without backend (default)
# false = API mode: calls the FastAPI backend below
EXPO_PUBLIC_USE_MOCKS=true

# FastAPI URL. On a physical phone use your computer's LAN IP, not localhost.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000

# Auth0 — fill these in, then restart Expo (`npx expo start -c`).
# Domain + Client ID: Auth0 Dashboard > Applications > Applications > your Native app.
# Audience: Auth0 Dashboard > Applications > APIs > your API > Identifier.
# Do NOT include https:// in the domain.
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=
