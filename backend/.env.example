# Copy to backend/.env — this file is gitignored. Secrets live ONLY here, never in the mobile app.
APP_ENV=development
CORS_ORIGINS=*

# PostgreSQL (leave empty to run without a database)
DATABASE_URL=
# DATABASE_URL=postgresql+psycopg://wwhealth:wwhealth@localhost:5432/wwhealth

# Supabase (empty = demo user + in-memory data). Auth tokens are verified with the project's JWKS.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret key: backend only, never in the Expo app or git. Not required for user requests (RLS).
SUPABASE_SECRET_KEY=
SUPABASE_DOCUMENTS_BUCKET=medical-documents

# External APIs (empty = demo responses)
GEMINI_API_KEY=
# Optional: model used by AI Medical Intelligence (default gemini-3.5-flash-lite)
GEMINI_SUMMARY_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# LungVision: true = call ai/inference/predict.py, false = demo result
USE_AI_MODEL=false
# LungVision (POST /api/ai/lung/analyze) — needs requirements-ml.txt. Path relative to backend/.
LUNGVISION_WEIGHTS_PATH=models/lungvision_best.pth

# QR access tokens
ACCESS_TOKEN_MAX_TTL_MINUTES=240
